{
  "name": "Node + dbt Fusion Feature",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:0-20-bullseye",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "dbtLabsInc.dbt",
        "evidence.evidence-vscode",
        "svelte.svelte-vscode"
      ]
    }
  },
  "initializeCommand": {
    "dbt setup": "mkdir -p /root/pipeline/.dbt && cp pipeline/profiles.yml /root/pipeline/.dbt/",
    "bi setup": "echo \"EVIDENCE_SOURCE__token=${MOTHERDUCK_TOKEN}\" > reports/.env"
  },
  "postCreateCommand": {
    "dbt dependencies": "curl -fsSL https://public.cdn.getdbt.com/fs/install/install.sh | sh -s -- --update",
    "bi dependencies": "cd reports/ && npm install && npm run sources"
  }
}